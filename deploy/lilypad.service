[Unit]
Description=Lily Pad - Toddler Keyboard Playground (kiosk)
Documentation=https://github.com/Glytchedup/project_lily_pad
# Own the console: never let a login prompt share tty1 with the toddler.
Conflicts=getty@tty1.service
After=systemd-user-sessions.service getty@tty1.service
Wants=multi-user.target
# Re-derive the HDMI audio card before the mixer opens. Wants= not Requires=:
# if it fails the playground still starts, just possibly on the wrong card.
Wants=lilypad-audio.service
After=lilypad-audio.service
# Never give up permanently. systemd's default (5 starts / 10 s) latches the
# unit into `failed` after a burst — which on an appliance means a black screen
# that stays black even once the underlying problem clears. Verified on-device:
# a monitor that was off at boot produced a restart storm that sat just under
# the default burst by luck. 0 disables the limit; the app itself now waits for
# a display rather than exiting, so this is the backstop, not the fix.
StartLimitIntervalSec=0

[Service]
Type=simple
# Root on purpose: evdev EVIOCGRAB + DRM master + USB control transfers
# on a single-purpose appliance (RESEARCH.md §2, PLAN.md D5).
User=root
WorkingDirectory=/opt/lilypad
ExecStart=/opt/lilypad/venv/bin/python -m lilypad --kiosk --config /etc/lilypad/config.toml
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=PYTHONUNBUFFERED=1
# Clean exit (parent escape combo) stays stopped; crashes restart in 2s.
Restart=on-failure
RestartSec=2
# The app handles SIGTERM and exits in well under a second. This is the
# backstop: systemd's 90 s default meant that when the app *didn't* handle it,
# every stop, restart and reboot of the appliance stalled for a minute and a
# half before SIGKILL. Never let a wedged frame hold up a shutdown that long.
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
